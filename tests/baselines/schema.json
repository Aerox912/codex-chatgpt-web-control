{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aerox912/codex-chatgpt-web-control/tests/baselines/schema.json",
  "title": "Codex ChatGPT Web Control baseline evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "engine",
    "scenarioId",
    "upstream",
    "platform",
    "runtime",
    "startedAt",
    "completedAt",
    "status",
    "evidence"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "engine": { "enum": ["web-model", "visible-control"] },
    "scenarioId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string", "minLength": 3 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "packageVersion": { "type": "string", "minLength": 1 }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "properties": {
        "node": { "type": "string" },
        "bun": { "type": "string" },
        "launcher": { "type": "string" }
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pass", "fail", "blocked"] },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "inherited": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "summary"],
        "properties": {
          "kind": { "enum": ["assertion", "log", "screenshot", "artifact", "manual"] },
          "summary": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
